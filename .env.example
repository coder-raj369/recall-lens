# Copy to .env and adjust as needed. Credentials match docker-compose.yml (local development only).
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall_lens

# Claude arbitration of cases the rules cannot decide. Off by default: every call is billed.
# Enabling it needs `uv sync --group llm` and an Anthropic API key.
RECALL_LENS_ARBITRATE=0
# ANTHROPIC_API_KEY=
